# Server Configuration
PORT=4000
NODE_ENV=development
APP_NAME=amrutam-telemedicine-backend
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/amrutam_db?schema=public

# Redis Configuration (Cache & Rate Limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets & Security
JWT_ACCESS_SECRET=amrutam_super_secure_access_token_secret_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=amrutam_super_secure_refresh_token_secret_min_32_chars
JWT_REFRESH_EXPIRY=7d
DATA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Payment Gateway (Razorpay & Mock)
PAYMENT_GATEWAY_PROVIDER=MOCK
RAZORPAY_KEY_ID=rzp_test_sample_key
RAZORPAY_KEY_SECRET=rzp_test_sample_secret
RAZORPAY_WEBHOOK_SECRET=sample_webhook_secret_for_hmac

# Telehealth Video Meeting Provider (MOCK / JITSI / DAILY)
TELEHEALTH_PROVIDER=MOCK
TELEHEALTH_SECRET=sample_telehealth_jwt_secret

# Logging & Monitoring
LOG_LEVEL=info
PROMETHEUS_METRICS_ENABLED=true
