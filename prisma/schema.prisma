datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
  SUPPORT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum SlotStatus {
  AVAILABLE
  RESERVED
  BOOKED
  CANCELLED
}

enum ConsultationStatus {
  BOOKED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ConsultationMode {
  VIDEO
  AUDIO
  CHAT
}

enum PaymentStatus {
  PENDING
  CAPTURED
  FAILED
  REFUNDED
}

enum PaymentProvider {
  RAZORPAY
  STRIPE
  MOCK
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

enum WebhookEventStatus {
  RECEIVED
  VERIFIED
  PROCESSED
  FAILED
  REJECTED
}

enum IdempotencyStatus {
  PENDING_CLAIM
  COMPLETED
  FAILED
}

enum ConsentType {
  TELEMEDICINE_CONSULTATION
  DATA_PROCESSING
  PRESCRIPTION_DELIVERY
}

model User {
  id              String             @id @default(uuid())
  email           String             @unique
  phone           String             @unique
  passwordHash    String             @map("password_hash")
  role            Role               @default(PATIENT)
  status          UserStatus         @default(ACTIVE)
  mfaEnabled      Boolean            @default(false) @map("mfa_enabled")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  patientProfile  PatientProfile?
  doctorProfile   DoctorProfile?
  mfaCredential   UserMfaCredential?
  refreshSessions RefreshSession[]
  auditLogs       AuditLog[]         @relation("UserAuditLogs")

  @@map("users")
}

model UserMfaCredential {
  id                  String    @id @default(uuid())
  userId              String    @unique @map("user_id")
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  encryptedTotpSecret String    @map("encrypted_totp_secret") @db.Text
  iv                  String    @map("iv")
  authTag             String    @map("auth_tag")
  hashedBackupCodes   String[]  @default([]) @map("hashed_backup_codes")
  verified            Boolean   @default(false)
  lastUsedAt          DateTime? @map("last_used_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@map("user_mfa_credentials")
}

model PatientProfile {
  id               String                @id @default(uuid())
  userId           String                @unique @map("user_id")
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName         String                @map("full_name")
  dateOfBirth      DateTime?             @map("date_of_birth")
  gender           String?
  bloodGroup       String?               @map("blood_group")
  emergencyContact String?               @map("emergency_contact")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  consultations    Consultation[]
  prescriptions    Prescription[]
  consents         ConsultationConsent[]

  @@map("patient_profiles")
}

model DoctorProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique @map("user_id")
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName           String             @map("full_name")
  licenseNumber      String             @unique @map("license_number")
  specializations    String[]
  qualifications     String[]
  experienceYears    Int                @default(0) @map("experience_years")
  consultationFee    Decimal            @map("consultation_fee") @db.Decimal(10, 2)
  supportedModes     ConsultationMode[] @default([VIDEO]) @map("supported_modes")
  languages          String[]           @default(["English", "Hindi"])
  bio                String?            @db.Text
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  verifiedAt         DateTime?          @map("verified_at")
  verifiedBy         String?            @map("verified_by")
  rejectionReason    String?            @map("rejection_reason") @db.Text
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  slots              AvailabilitySlot[]
  consultations      Consultation[]
  prescriptions      Prescription[]

  @@index([verificationStatus])
  @@map("doctor_profiles")
}

model AvailabilitySlot {
  id          String        @id @default(uuid())
  doctorId    String        @map("doctor_id")
  doctor      DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  startTime   DateTime      @map("start_time")
  endTime     DateTime      @map("end_time")
  status      SlotStatus    @default(AVAILABLE)
  version     Int           @default(0)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  consultation Consultation?

  @@index([doctorId, startTime, endTime, status])
  @@map("availability_slots")
}

model Consultation {
  id                 String               @id @default(uuid())
  slotId             String               @unique @map("slot_id")
  slot               AvailabilitySlot     @relation(fields: [slotId], references: [id])
  patientId          String               @map("patient_id")
  patient            PatientProfile       @relation(fields: [patientId], references: [id])
  doctorId           String               @map("doctor_id")
  doctor             DoctorProfile        @relation(fields: [doctorId], references: [id])
  status             ConsultationStatus   @default(BOOKED)
  mode               ConsultationMode     @default(VIDEO)
  meetingRoomId      String?              @map("meeting_room_id")
  meetingToken       String?              @map("meeting_token")
  cancellationReason String?              @map("cancellation_reason")
  cancelledBy        String?              @map("cancelled_by")
  consentRecorded    Boolean              @default(false) @map("consent_recorded")
  consentTimestamp   DateTime?            @map("consent_timestamp")
  clinicalNotes      String?              @map("clinical_notes") @db.Text
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  prescriptions      Prescription[]
  payment            Payment?
  consent            ConsultationConsent?

  @@index([patientId, status])
  @@index([doctorId, status])
  @@map("consultations")
}

model ConsultationConsent {
  id             String         @id @default(uuid())
  consultationId String         @unique @map("consultation_id")
  consultation   Consultation   @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  patientId      String         @map("patient_id")
  patient        PatientProfile @relation(fields: [patientId], references: [id])
  consentType    ConsentType    @default(TELEMEDICINE_CONSULTATION) @map("consent_type")
  version        String         @default("TPG_2020_V1")
  granted        Boolean        @default(false)
  timestamp      DateTime       @default(now())
  ipAddress      String?        @map("ip_address")
  userAgent      String?        @map("user_agent")

  @@index([patientId])
  @@map("consultation_consents")
}

model Prescription {
  id                   String             @id @default(uuid())
  consultationId       String             @map("consultation_id")
  consultation         Consultation       @relation(fields: [consultationId], references: [id])
  doctorId             String             @map("doctor_id")
  doctor               DoctorProfile      @relation(fields: [doctorId], references: [id])
  patientId            String             @map("patient_id")
  patient              PatientProfile     @relation(fields: [patientId], references: [id])
  version              Int                @default(1)
  parentPrescriptionId String?            @map("parent_prescription_id")
  parentPrescription   Prescription?      @relation("PrescriptionRevisions", fields: [parentPrescriptionId], references: [id])
  revisions            Prescription[]     @relation("PrescriptionRevisions")
  amendmentReason      String?            @map("amendment_reason")
  diagnosis            String             @db.Text
  advice               String?            @db.Text
  doctorSignature      String             @map("doctor_signature")
  createdAt            DateTime           @default(now()) @map("created_at")

  items                PrescriptionItem[]

  @@unique([consultationId, version], name: "consultation_version_unique")
  @@index([consultationId])
  @@index([patientId])
  @@map("prescriptions")
}

model PrescriptionItem {
  id             String       @id @default(uuid())
  prescriptionId String       @map("prescription_id")
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicineName   String       @map("medicine_name")
  dosage         String
  frequency      String
  durationDays   Int          @map("duration_days")
  instructions   String?
  createdAt      DateTime     @default(now()) @map("created_at")

  @@map("prescription_items")
}

model Payment {
  id                String          @id @default(uuid())
  consultationId    String          @unique @map("consultation_id")
  consultation      Consultation    @relation(fields: [consultationId], references: [id])
  patientId         String          @map("patient_id")
  amount            Decimal         @db.Decimal(10, 2)
  currency          String          @default("INR")
  status            PaymentStatus   @default(PENDING)
  provider          PaymentProvider @default(MOCK)
  providerOrderId   String?         @unique @map("provider_order_id")
  providerPaymentId String?         @unique @map("provider_payment_id")
  idempotencyKey    String?         @unique @map("idempotency_key")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  @@index([status])
  @@map("payments")
}

model PaymentWebhookEvent {
  id             String             @id @default(uuid())
  provider       PaymentProvider
  eventId        String             @map("event_id")
  eventType      String             @map("event_type")
  payload        Json
  signatureValid Boolean            @map("signature_valid")
  status         WebhookEventStatus @default(RECEIVED)
  errorMessage   String?            @map("error_message")
  receivedAt     DateTime           @default(now()) @map("received_at")
  processedAt    DateTime?          @map("processed_at")

  @@unique([provider, eventId], name: "provider_event_unique")
  @@index([status, receivedAt])
  @@map("payment_webhook_events")
}

model IdempotencyRecord {
  id             String            @id @default(uuid())
  scope          String
  key            String
  operation      String
  requestHash    String            @map("request_hash")
  status         IdempotencyStatus @default(PENDING_CLAIM)
  responseStatus Int?              @map("response_status")
  responseBody   Json?             @map("response_body")
  claimedAt      DateTime          @default(now()) @map("claimed_at")
  completedAt    DateTime?         @map("completed_at")
  expiresAt      DateTime          @map("expires_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  @@unique([scope, operation, key], name: "scope_operation_key_unique")
  @@index([expiresAt])
  @@index([status, claimedAt])
  @@map("idempotency_records")
}

model OutboxEvent {
  id            String       @id @default(uuid())
  aggregateType String       @map("aggregate_type")
  aggregateId   String       @map("aggregate_id")
  eventType     String       @map("event_type")
  payload       Json
  status        OutboxStatus @default(PENDING)
  retryCount    Int          @default(0) @map("retry_count")
  maxRetries    Int          @default(5) @map("max_retries")
  lastError     String?      @map("last_error")
  nextRetryAt   DateTime     @default(now()) @map("next_retry_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@index([status, nextRetryAt])
  @@map("outbox_events")
}

model RefreshSession {
  id                  String    @id @default(uuid())
  userId              String    @map("user_id")
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash           String    @unique @map("token_hash")
  familyId            String    @default(uuid()) @map("family_id")
  replacedByTokenHash String?   @map("replaced_by_token_hash")
  ipAddress           String?   @map("ip_address")
  userAgent           String?   @map("user_agent")
  revoked             Boolean   @default(false)
  revokedAt           DateTime? @map("revoked_at")
  revocationReason    String?   @map("revocation_reason")
  expiresAt           DateTime  @map("expires_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([userId, revoked])
  @@index([familyId])
  @@map("refresh_sessions")
}

model AuditLog {
  id            String   @id @default(uuid())
  actorId       String?  @map("actor_id")
  actor         User?    @relation("UserAuditLogs", fields: [actorId], references: [id])
  actorRole     String?  @map("actor_role")
  action        String
  resourceType  String   @map("resource_type")
  resourceId    String?  @map("resource_id")
  changeset     Json?
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  correlationId String?  @map("correlation_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([resourceType, resourceId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}
