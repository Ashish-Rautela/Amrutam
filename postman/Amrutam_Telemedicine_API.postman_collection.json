        {
          "name": "3.2 Create Availability Slot (Doctor)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Generate dynamic future slot time 2 days from now",
                  "const target = new Date();",
                  "target.setDate(target.getDate() + 2);",
                  "target.setHours(14, 0, 0, 0);",
                  "const end = new Date(target);",
                  "end.setMinutes(30);",
                  "pm.environment.set('slotStartTime', target.toISOString());",
                  "pm.collectionVariables.set('slotStartTime', target.toISOString());",
                  "pm.environment.set('slotEndTime', end.toISOString());",
                  "pm.collectionVariables.set('slotEndTime', end.toISOString());"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Slot created successfully (201 Created)', function () {",
                  "    pm.response.to.have.status(201);",
                  "    const json = pm.response.json();",
                  "    if (json.data && json.data.length > 0) {",
                  "        pm.environment.set('slotId', json.data[0].id);",
                  "        pm.collectionVariables.set('slotId', json.data[0].id);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{doctorToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slots\": [\n    {\n      \"startTime\": \"{{slotStartTime}}\",\n      \"endTime\": \"{{slotEndTime}}\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "http://localhost:4000/api/v1/availability/slots",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "4000",
              "path": [
                "api",
                "v1",
                "availability",
                "slots"
              ]
            }
          }
        },
