    {
      "name": "2. Auth & Identity",
      "item": [
        {
          "name": "2.1 Patient Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"patient@amrutam.co.in\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "http://localhost:4000/api/v1/auth/login",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "4000",
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Patient login successful (200 OK)\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const json = pm.response.json();",
                  "    const tokens = json.data?.tokens || json.data;",
                  "    const accessToken = tokens?.accessToken;",
                  "    const refreshToken = tokens?.refreshToken;",
                  "    pm.expect(accessToken).to.be.a(\"string\");",
                  "    pm.environment.set(\"patientToken\", accessToken);",
                  "    pm.collectionVariables.set(\"patientToken\", accessToken);",
                  "    if (refreshToken) {",
                  "        pm.environment.set(\"patientRefreshToken\", refreshToken);",
                  "        pm.collectionVariables.set(\"patientRefreshToken\", refreshToken);",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        },
