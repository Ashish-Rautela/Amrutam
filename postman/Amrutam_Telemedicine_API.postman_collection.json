    {
      "name": "5. Legal Consent (TPG 2020) & Clinical Workflow",
      "item": [
        {
          "name": "5.1 Doctor Attempt Start Before Consent (Fails)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{doctorToken}}"
              }
            ],
            "url": {
              "raw": "http://localhost:4000/api/v1/consultations/{{consultationId}}/start",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "4000",
              "path": [
                "api",
                "v1",
                "consultations",
                "{{consultationId}}",
                "start"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
