        {
          "name": "2.4 Token Refresh & Family Rotation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{patientRefreshToken}}\"\n}"
            },
            "url": {
              "raw": "http://localhost:4000/api/v1/auth/refresh",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "4000",
              "path": [
                "api",
                "v1",
                "auth",
                "refresh"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.variables.get(\"patientRefreshToken\")) {",
                  "    pm.sendRequest({",
                  "        url: \"http://localhost:4000/api/v1/auth/login\",",
                  "        method: \"POST\",",
                  "        header: { \"Content-Type\": \"application/json\" },",
                  "        body: { mode: \"raw\", raw: JSON.stringify({ email: \"patient@amrutam.co.in\", password: \"Password123!\" }) }",
                  "    }, function (err, res) {",
                  "        if (!err && res.code === 200) {",
                  "            const data = res.json().data;",
                  "            const token = data.tokens?.refreshToken || data.refreshToken;",
                  "            pm.environment.set(\"patientRefreshToken\", token);",
                  "            pm.collectionVariables.set(\"patientRefreshToken\", token);",
                  "        }",
                  "    });",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Token refreshed and rotated (200 OK)\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const json = pm.response.json();",
                  "    const tokens = json.data?.tokens || json.data;",
                  "    const accessToken = tokens?.accessToken;",
                  "    const refreshToken = tokens?.refreshToken;",
                  "    if (accessToken) {",
                  "        pm.environment.set(\"patientToken\", accessToken);",
                  "        pm.collectionVariables.set(\"patientToken\", accessToken);",
                  "    }",
                  "    if (refreshToken) {",
                  "        pm.environment.set(\"patientRefreshToken\", refreshToken);",
                  "        pm.collectionVariables.set(\"patientRefreshToken\", refreshToken);",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        },
