                "admin",
                "analytics",
                "overview"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get(\"adminToken\") && !pm.environment.get(\"adminToken\")) {",
                  "    pm.sendRequest({",
                  "        url: \"http://localhost:4000/api/v1/auth/login\",",
                  "        method: \"POST\",",
                  "        header: { \"Content-Type\": \"application/json\" },",
                  "        body: {",
                  "            mode: \"raw\",",
                  "            raw: JSON.stringify({ email: \"admin@amrutam.co.in\", password: \"Password123!\" })",
                  "        }",
                  "    }, function (err, res) {",
                  "        if (!err && res.code === 200) {",
                  "            const data = res.json();",
                  "            const token = data.data?.tokens?.accessToken || data.data?.accessToken;",
                  "            if (token) {",
                  "                pm.collectionVariables.set(\"adminToken\", token);",
                  "                pm.environment.set(\"adminToken\", token);",
                  "            }",
                  "        }",
                  "    });",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
