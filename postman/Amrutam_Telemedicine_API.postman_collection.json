            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slots\": [\n    {\n      \"startTime\": \"{{slotStartTime}}\",\n      \"endTime\": \"{{slotEndTime}}\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "http://localhost:4000/api/v1/availability/slots",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "4000",
              "path": [
                "api",
                "v1",
                "availability",
                "slots"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
