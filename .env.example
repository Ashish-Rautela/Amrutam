# Server Configuration
PORT=4000
NODE_ENV=development
APP_NAME=amrutam-telemedicine-backend
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# Database Configuration (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_strong_password_min_16_chars
POSTGRES_DB=amrutam_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:replace_with_strong_password_min_16_chars@localhost:5432/amrutam_db?schema=public

# Redis Configuration (Cache & Rate Limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & Secrets (MANDATORY IN PRODUCTION - application refuses to start if insecure)
# Generate using: openssl rand -hex 32
JWT_ACCESS_SECRET=replace_with_cryptographically_secure_random_key_min_32_characters
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=replace_with_cryptographically_secure_random_key_min_32_characters
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=amrutam-telemedicine
JWT_AUDIENCE=amrutam-api
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000

# 256-bit AES encryption key for TOTP secrets and sensitive health records (Exactly 64 hex characters)
# Generate using: openssl rand -hex 32
DATA_ENCRYPTION_KEY=replace_with_64_character_hexadecimal_string_32_bytes_aes256

# Payment Gateway (MOCK / RAZORPAY)
PAYMENT_GATEWAY_PROVIDER=MOCK
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Telehealth Video Meeting Provider (MOCK / JITSI / DAILY)
TELEHEALTH_PROVIDER=MOCK
TELEHEALTH_SECRET=replace_with_secure_telehealth_signing_secret

# Observability
LOG_LEVEL=info
PROMETHEUS_METRICS_ENABLED=true
